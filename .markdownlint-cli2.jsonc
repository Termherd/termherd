{
  // Project docs: enforce 80-col prose, but don't fight tables / code blocks /
  // anchor HTML / cosmetic table-pipe alignment.
  "config": {
    "MD013": { "line_length": 80, "tables": false, "code_blocks": false },
    "MD033": false,
    "MD060": false
  },
  // Lint every doc by default, so a bare `markdownlint-cli2` mirrors CI
  // (whose action passes the same glob explicitly).
  "globs": ["**/*.md"],
  // CLAUDE.md is only an `@AGENTS.md` import pointer, not prose. `.personal/`
  // and `.local/` are gitignored working notes: CI never sees them (fresh
  // clone), so linting them locally only reports errors no one can act on and
  // teaches you to skim past the summary line.
  //
  // `.claude/worktrees/` holds checkouts of *other branches* — gitignored,
  // absent from a fresh clone, so this entry matches nothing in CI. It exists
  // because otherwise the scope of a run from the repo root is a function of
  // local working state, not of the repo: measured within one hour of each
  // other, the same command linted 169 files and then 263, while the repo's
  // own tracked total stayed 75. The difference is other branches' committed
  // content, which a failure here could not be fixed in anyway — the same
  // reason `.personal/` is excluded. Nothing was failing when this was added;
  // a gate whose file count moves with how many worktrees exist is one whose
  // green line stops meaning anything. Lint a worktree from inside it, where
  // its own config applies.
  //
  // ROADMAP.md is generated, and is linted anyway: an artifact nobody may edit
  // is exactly the one whose lint failures are a generator bug worth seeing.
  // It was excluded only while roadmark emitted an 86-column banner no local
  // edit could shorten; the generator now wraps it.
  //
  // docs/book/ is mdbook's build output — generated HTML with a few stray .md
  // artifacts, regenerated by `just docs` and never committed. docs/src/
  // SUMMARY.md is mdbook's table of contents, whose part headers are H1s *by
  // specification* (MD025): it is structure, not prose.
  "ignores": [
    "target/**",
    "node_modules/**",
    "docs/book/**",
    "docs/src/SUMMARY.md",
    "CLAUDE.md",
    ".personal/**",
    ".local/**",
    ".claude/worktrees/**"
  ]
}
